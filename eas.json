{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "personal-beta": {
      "credentialsSource": "local",
      "distribution": "internal",
      "channel": "personal-beta",
      "environment": "preview",
      "env": { "KANAKKU_BUILD_PROFILE": "personal" },
      "android": { "buildType": "apk" }
    },
    "e2e": {
      "credentialsSource": "local",
      "distribution": "internal",
      "channel": "e2e",
      "environment": "preview",
      "env": { "KANAKKU_BUILD_PROFILE": "e2e" },
      "android": { "buildType": "apk" }
    }
  }
}
