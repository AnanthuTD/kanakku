{
  "name": "kanakku",
  "version": "0.2.0-beta.12",
  "description": "Kanakku: private on-device SMS spend journal for Android",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.3",
    "buffer": "^6.0.3",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-modules-core": "~58.0.23",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "lucide-react-native": "^1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "test:e2e:phone": "playwright test --project=phone",
    "test:e2e:report": "playwright show-report",
    "e2e:serve": "npm run export:web && node scripts/serve-e2e.mjs",
    "test:regression": "npm run typecheck && npm test && npm run test:voice:fixtures && npm run test:native && npm run test:e2e",
    "test:native": "node scripts/test-native.mjs",
    "adb:pair": "node scripts/adb-pair.mjs",
    "brand:render": "node scripts/render-brand.mjs",
    "emulator:setup": "node scripts/android-emulator.mjs setup",
    "emulator:start": "node scripts/android-emulator.mjs start",
    "emulator:stop": "node scripts/android-emulator.mjs stop",
    "test:android:emulator": "node scripts/android-emulator.mjs test",
    "verify:apk": "node scripts/verify-apk.mjs",
    "test:android:pipeline": "node scripts/android-pipeline.mjs",
    "test:android:credentials": "node scripts/android-credentials.mjs",
    "test:voice:fixtures": "node scripts/evaluate-whisper-audio.mjs --verify && node --test tests/voice/scorer-checks.mjs",
    "voice:model": "node scripts/set-voice-model.mjs",
    "models:fetch": "node scripts/fetch-models.mjs",
    "models:catalog": "node scripts/write-model-catalog.mjs",
    "test:models:android": "node scripts/test-model-downloads.mjs"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnanthuTD/kanakku.git"
  }
}
