{
  "name": "kanakku",
  "version": "0.2.0-beta.2",
  "description": "Kanakku: private on-device SMS spend journal for Android",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.3",
    "buffer": "^6.0.3",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "lucide-react-native": "^1.56.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.10",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "test:e2e:phone": "playwright test --project=phone",
    "test:e2e:report": "playwright show-report",
    "e2e:serve": "npm run export:web && node scripts/serve-e2e.mjs",
    "test:regression": "npm run typecheck && npm test && npm run test:dependencies && npm run test:voice:fixtures && npm run test:native && npm run test:e2e",
    "test:native": "node scripts/test-native.mjs",
    "adb:pair": "node scripts/adb-pair.mjs",
    "brand:render": "node scripts/render-brand.mjs",
    "emulator:setup": "node scripts/android-emulator.mjs setup",
    "emulator:start": "node scripts/android-emulator.mjs start",
    "emulator:stop": "node scripts/android-emulator.mjs stop",
    "test:android:emulator": "node scripts/android-emulator.mjs test",
    "verify:apk": "node scripts/verify-apk.mjs",
    "test:dependencies": "node --test scripts/test-dependencies.mjs",
    "test:android:pipeline": "node scripts/android-pipeline.mjs",
    "test:android:credentials": "node scripts/android-credentials.mjs",
    "test:voice:fixtures": "node scripts/evaluate-whisper-audio.mjs --verify && node --test tests/voice/scorer-checks.mjs",
    "voice:model": "node scripts/set-voice-model.mjs",
    "models:fetch": "node scripts/fetch-models.mjs"
  },
  "private": true,
  "overrides": {
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnanthuTD/kanakku.git"
  }
}
